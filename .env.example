# Copy to .env for local development. Never commit real values.

# Set by `shopify app dev` from the linked Partner app; don't hard-code.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,read_content,read_online_store_pages,read_translations,write_translations,read_locales

# Runtime role (row-level security applies).
DATABASE_URL=postgresql://linguva_app:linguva_app_dev@localhost:5432/linguva_dev
# Owner role, used only by `pnpm db:migrate`.
MIGRATION_DATABASE_URL=postgresql://linguva_owner:linguva_owner_dev@localhost:5432/linguva_dev

# Comma-separated kid:base64(32 random bytes). First key encrypts, all decrypt.
# Generate one with:
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEYS=

LOG_LEVEL=info

# Optional. Without a key, AI translation is disabled and manual translation
# still works. Keys ending in ":fx" use the DeepL Free endpoint.
DEEPL_API_KEY=
# The operator's own stores (*.myshopify.com, comma-separated): only they see the DeepL keys' quota (or, with several engines, the translation services) on the Overview.
# OPERATOR_SHOPS=
# More DeepL keys (commas, spaces or line breaks): the next one is used when a key's quota is used up or it is refused.
# DEEPL_API_KEY_2=
# DEEPL_API_KEY_3=   (one variable per extra key, numbered in order: the number sets the order)
# DEEPL_API_KEYS=
# DEEPL_API_URL=https://api.deepl.com
# More AI engines (optional). With only DeepL set, nothing changes. Each one is a
# data processor: add it only after the owner's decision and the lawyer's review
# of its privacy section (docs/AI_ENGINES.md). DeepL, when set, is always tried first.
# Microsoft Azure Translator: Azure portal > your Translator resource > Keys and Endpoint.
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=westeurope
# Leave empty: Microsoft's EU endpoint (texts processed in the EU only). The portal shows
# the global endpoint; setting that one allows processing outside the EU.
# AZURE_TRANSLATOR_ENDPOINT=
# Google Cloud Translation, simple: an API key restricted to the Cloud Translation API (global processing).
# GOOGLE_TRANSLATE_API_KEY=
# Google Cloud Translation, professional: the service account's JSON key file (EU processing).
# GOOGLE_TRANSLATE_CREDENTIALS=
# Which engines and in which order (default deepl,azure,google).
# TRANSLATION_ENGINES=deepl,azure,google
# Cost estimates per engine (USD per million characters).
# AI_COST_USD_PER_MILLION_CHARS_AZURE=10
# AI_COST_USD_PER_MILLION_CHARS_GOOGLE=20
# Monthly AI character allowance per shop (until plans are wired to billing).
AI_MONTHLY_CHAR_LIMIT=20000
# Cost safety. Daily cap per shop (UTC day; never above the monthly allowance),
# cap across all shops per day, and the largest single interactive request.
# Production with billing (docs/PRICING_DECISION.md §8, §9 step 6):
#   AI_DAILY_CHAR_LIMIT=1000000
#   AI_PLATFORM_DAILY_CHAR_LIMIT=3000000 (raise it by the rule in §8; with
#   BILLING_REQUIRED=true a value below 1,000,000 is logged as a warning at start)
AI_DAILY_CHAR_LIMIT=10000
AI_PLATFORM_DAILY_CHAR_LIMIT=100000
AI_MAX_CHARS_PER_REQUEST=20000
# Interactive AI requests per minute, per staff member and per shop, and
# translation memory suggestions per staff member and minute.
AI_USER_REQUESTS_PER_MINUTE=10
AI_SHOP_REQUESTS_PER_MINUTE=30
MEMORY_SUGGESTIONS_PER_MINUTE=30

# Shopify App Pricing (optional until plans exist in the Partner Dashboard).
# Without these, billing is off and all features are available.
# The Partner API token can read data of every store in the organization:
# keep it in a secret manager, never in the repository.
# SHOPIFY_PARTNER_ORG_ID=
# SHOPIFY_PARTNER_API_TOKEN=
# SHOPIFY_APP_GID=gid://shopify/App/<id>
# SHOPIFY_APP_HANDLE=linguva
# Set BILLING_REQUIRED=true last, once the plans exist exactly as
# docs/PRICING_DECISION.md §9 says and the dev-store checks passed.
# BILLING_REQUIRED=false
# The Own key plan's card and website texts (on only after the plan exists in the Partner Dashboard).
# OWN_KEY_PLAN_VISIBLE=off
# Own key plan: key checks per minute and staff member (default 3; the shop gets twice as many).
# OWN_KEY_CHECKS_PER_MINUTE=3

# Owner complimentary access (docs/BILLING_DESIGN.md §4): Shopify shop GIDs of
# your own stores, comma-separated. Also needs a grant with the operator tool
# (pnpm ops:complimentary grant ...). Not a secret, but never a customer store.
# COMPLIMENTARY_SHOP_GIDS=gid://shopify/Shop/123
# Internal AI cost estimate (USD per million characters sent to the provider).
# Production: DeepL API Growth's rate, 27.5 (docs/PRICING_DECISION.md §4).
# AI_COST_USD_PER_MILLION_CHARS=25

# Background jobs (bulk translation) and shared rate limits. Without Redis,
# bulk translation is off and rate limits are per process. Required in production.
REDIS_URL=redis://localhost:6379
# "engines" (default: the engines above; "deepl" is the older spelling of the same)
# or "mock" for development. "mock" is refused in production.
TRANSLATION_PROVIDER=deepl
# Per-shop Shopify Admin API budget for background jobs, and worker concurrency.
SHOPIFY_JOB_BUCKET_SIZE=800
SHOPIFY_JOB_RESTORE_PER_SECOND=80
WORKER_CONCURRENCY=5

# Hosted stages only (docs/RAILWAY_STAGING.md); leave unset for local development.
# LINGUVA_STAGE=staging                       # staging | production
# ALLOWED_SHOPS=linguva-test-lab.myshopify.com  # stores this deployment may serve (required in staging)
# LINGUVA_PRODUCTION_APPROVED=yes             # production only, set by the owner for an approved release
# PUBLIC_PAGES=off                            # on: serve /privacy (the app's privacy policy) and /support, and link them from the website (default off: 404)
# LEGAL_TEXTS_REVIEWED=yes                    # after the lawyer's review: hides the draft notice (needed for PUBLIC_PAGES=on in production)
# LINGUVA_EMBEDDED_WORKER=on                  # the built web server (pnpm start, image) runs the worker (default: on in production only; off: any other value; never in pnpm dev, use pnpm worker:dev)
