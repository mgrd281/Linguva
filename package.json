{
  "name": "linguva",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "react-router build && pnpm run build:worker && pnpm run build:ops",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "pnpm run setup && pnpm run start",
    "setup": "prisma generate && node scripts/migrate.mjs",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "node scripts/migrate.mjs",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=build/worker/index.js",
    "worker": "LOG_SERVICE=linguva-worker node build/worker/index.js",
    "build:ops": "esbuild scripts/ops/complimentary.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=build/ops/complimentary.js",
    "ops:complimentary": "node build/ops/complimentary.js",
    "test:security": "vitest run --project security",
    "test:performance": "vitest run --project performance",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check:ignored": "node scripts/check-ignored.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.2",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "bullmq": "6.3.12",
    "ioredis": "6.0.0",
    "isbot": "^5.1.31",
    "parse5": "^8.0.1",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^6.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0",
      "p-map": "^4.0.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
