{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	try_files {path} {path}.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; script-src 'sha256-eT+fuEfkdzgvJLqNUEUyHpzXVkGNZkjC8Gc5XYQ/o44='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=3600"

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
